# Instagram access token with instagram_manage_messages permission
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Your Instagram Business/Creator account user ID
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Polling interval in seconds (default: 60) – only used in continuous (non-cron) mode
POLL_INTERVAL=60

# --- Google Drive credentials ---
# Option A (recommended for CI/CD): paste the full contents of the service-account
# JSON key file into this variable.  Used by GitHub Actions / any environment
# where writing files is undesirable.
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=

# Option B (local development): path to the service-account JSON key file on disk.
# Ignored when GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT is set.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Google Drive folder ID where media will be uploaded
# (copy the ID from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Optional: path to a local file that stores already-processed message IDs
# Used to avoid re-downloading already processed messages
STATE_FILE=last_seen.json

# Set to 'true' to run a single poll and exit (for use with external schedulers
# such as GitHub Actions cron).  Defaults to 'false' (continuous loop).
RUN_ONCE=false
