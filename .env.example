# Instagram access token with instagram_manage_messages permission
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Your Instagram Business/Creator account user ID
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Path to Google Drive service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Google Drive folder ID where media will be uploaded
# (copy the ID from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Optional: path to a local file that stores already-processed message IDs
# Used to avoid re-downloading already processed messages
STATE_FILE=last_seen.json
